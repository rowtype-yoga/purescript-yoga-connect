-- | Protocol buffer codecs worked out from message types, with no generated code.
-- |
-- | ```purescript
-- | type Quote = Message { symbol :: 1 := String, price :: 2 := Number, average :: 3 := Number }
-- |
-- | bytes = encode @Quote { symbol: "ACME", price: 121.5, average: 121.4 }
-- | decode @Quote bytes == Right { symbol: "ACME", price: 121.5, average: 121.4 }
-- | ```
-- |
-- | The bytes are what protoc's code writes for the same `.proto` (`Yoga.Connect.Proto` prints
-- | it), fields in the order of their numbers, fields at their default left out, so either side
-- | can be generated by protoc. Decoding takes fields in any order, skips the ones it doesn't
-- | know, and takes the last of a field that comes more than once (protoc would merge two halves
-- | of a nested message).
module Yoga.Connect.Protobuf
  ( codecOf
  , encode
  , decode
  , class ProtobufMessage
  , messageCodec
  , messageShape
  , class MethodMessage
  , methodCodec
  , methodShape
  , methodName
  , class MessageFields
  , readFields
  , memberShapes
  , class FieldWriters
  , fieldWriters
  , class Alternatives
  , readAlternatives
  , alternativeWriter
  , firstAlternative
  , alternativeShapes
  , class Field
  , fieldCodec
  , class Value
  , valueCodec
  , class EnumConstructors
  , enumNames
  , enumFromIndex
  , enumToIndex
  , FieldCodec
  , ValueCodec
  , NumberedWriter
  , MessageShape
  , Member(..)
  , FieldShape
  , Cardinality(..)
  , ValueKind(..)
  ) where

