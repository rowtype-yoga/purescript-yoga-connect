-- | The codec of a message type: `codecOf @Quote`.
codecOf :: forall @message plain. ProtobufMessage message plain => Codec plain
codecOf = messageCodec (Proxy :: Proxy message)

encode :: forall @message plain. ProtobufMessage message plain => plain -> Bytes
encode = Codec.encode (codecOf @message)

decode :: forall @message plain. ProtobufMessage message plain => Bytes -> Either DecodeError plain
decode = Codec.decode (codecOf @message)

-- | A message type, and what handlers see of it: a record of numbered fields is a record of
-- | their values, a `OneOf` a `Variant`.
class ProtobufMessage :: Type -> Type -> Constraint
class ProtobufMessage message plain | message -> plain where
  messageCodec :: Proxy message -> Codec plain
  messageShape :: Proxy message -> MessageShape

instance (RowToList fields list, MessageFields list plain, FieldWriters list plain) => ProtobufMessage (Record fields) (Record plain) where
  messageCodec _ = codec read write
    where
    members = memberShapes (Proxy :: Proxy list)
    readAll = readFields (Proxy :: Proxy list)
    read
      | Array.null members = mkFn3 \input start end -> runFn3 validated input start end *> (runFn3 readAll input start end <#> Builder.buildFromScratch)
      | otherwise = mkFn3 \input start end -> runFn3 readAll input start end <#> Builder.buildFromScratch
    writers = fieldWriters (Proxy :: Proxy list) # Array.sortWith (_.number >>> negate)
    write writer message = foreachE writers \field -> field.write writer message
  messageShape _ = memberShapes (Proxy :: Proxy list)

instance (RowToList alternatives list, Alternatives list plain) => ProtobufMessage (OneOf alternatives) (Variant plain) where
  messageCodec _ = codec read (alternativeWriter (Proxy :: Proxy list))
    where
    readLast = readAlternatives (Proxy :: Proxy list)
    unset = (firstAlternative (Proxy :: Proxy list)).value
    read = mkFn3 \input start end -> runFn3 readLast input start end <#> maybe unset (\(_ /\ chosen) -> chosen)
  messageShape _ = [ Choice "kind" (alternativeShapes (Proxy :: Proxy list)) ]

instance ProtobufMessage message plain => ProtobufMessage (Named name message) plain where
  messageCodec _ = messageCodec (Proxy :: Proxy message)
  messageShape _ = messageShape (Proxy :: Proxy message)

-- | What a method sends or answers with: a message, or any other field type, which goes as the
-- | only field, `value = 1`, of a message of its own. `Unary {} (Array Room) ()` takes an empty
-- | message and answers with a message of repeated rooms.
class MethodMessage :: Type -> Type -> Constraint
class MethodMessage message plain | message -> plain where
  methodCodec :: Proxy message -> Codec plain
  methodShape :: Proxy message -> MessageShape
  -- | The name `Named` gave it, if it has one.
  methodName :: Proxy message -> Maybe String

instance (IsSymbol name, MethodMessage message plain) => MethodMessage (Named name message) plain where
  methodCodec _ = methodCodec (Proxy :: Proxy message)
  methodShape _ = methodShape (Proxy :: Proxy message)
  methodName _ = Just (reflectSymbol (Proxy :: Proxy name))
else instance ProtobufMessage (Record fields) plain => MethodMessage (Record fields) plain where
  methodCodec = messageCodec
  methodShape = messageShape
  methodName _ = Nothing
else instance ProtobufMessage (OneOf alternatives) plain => MethodMessage (OneOf alternatives) plain where
  methodCodec = messageCodec
  methodShape = messageShape
  methodName _ = Nothing
else instance Field field plain => MethodMessage field plain where
  methodCodec _ = codec read write
    where
    value = fieldCodec (Proxy :: Proxy field) 1
    read = value.read
    write writer plain = value.write writer plain
  methodShape _ = [ Single { name: "value", number: 1, cardinality: (fieldCodec (Proxy :: Proxy field) 1).cardinality, kind: (fieldCodec (Proxy :: Proxy field) 1).kind } ]
  methodName _ = Nothing

-- | What a `.proto` says about a message: its fields and its `oneof`s.
type MessageShape = Array Member

data Member
  = Single FieldShape
  | Choice String (Array FieldShape)

type FieldShape = { name :: String, number :: Int, cardinality :: Cardinality, kind :: ValueKind }

data Cardinality = Once | Repeated | Optional

-- | A nested message or enum has the name `Named` gave it, if it has one.
data ValueKind
  = Scalar String
  | Nested (Maybe String) MessageShape
  | Enumeration (Maybe String) (Array String)

derive instance Eq Cardinality
derive instance Eq ValueKind
derive instance Eq Member

-- | Writes one field, or one `oneof`, of a message. A message's writers go in the order of
-- | their numbers.
type NumberedWriter message = { number :: Int, write :: Writer -> message -> Effect Unit }

-- | The fields of a message, by their row list: how to read them, and what they are.
class MessageFields :: RowList Type -> Row Type -> Constraint
class MessageFields list plain | list -> plain where
  readFields :: Proxy list -> Fn3 Bytes Int Int (Either DecodeError (Builder {} (Record plain)))
  memberShapes :: Proxy list -> Array Member

instance MessageFields RowList.Nil () where
  readFields _ = mkFn3 \_ _ _ -> Right identity
  memberShapes _ = []

else instance
  ( IsSymbol label
  , Reflectable number Int
  , Field field plainField
  , MessageFields tail plainTail
  , Row.Cons label plainField plainTail plain
  , Row.Lacks label plainTail
  ) =>
  MessageFields (RowList.Cons label (number := field) tail) plain where
  readFields _ = mkFn3 \input start end -> do
    found <- runFn3 this.read input start end
    rest <- runFn3 readRest input start end
    pure (Builder.insert (Proxy :: Proxy label) found <<< rest)
    where
    this = fieldCodec (Proxy :: Proxy field) (reflectType (Proxy :: Proxy number))
    readRest = readFields (Proxy :: Proxy tail)
  memberShapes _ = Array.cons (Single { name: reflectSymbol (Proxy :: Proxy label), number, cardinality: this.cardinality, kind: this.kind }) (memberShapes (Proxy :: Proxy tail))
    where
    number = reflectType (Proxy :: Proxy number)
    this = fieldCodec (Proxy :: Proxy field) number

else instance
  ( IsSymbol label
  , RowToList alternatives alternativeList
  , Alternatives alternativeList plainAlternatives
  , MessageFields tail plainTail
  , Row.Cons label (Variant plainAlternatives) plainTail plain
  , Row.Lacks label plainTail
  ) =>
  MessageFields (RowList.Cons label (OneOf alternatives) tail) plain where
  readFields _ = mkFn3 \input start end -> do
    found <- runFn3 readLast input start end
    rest <- runFn3 readRest input start end
    pure (Builder.insert (Proxy :: Proxy label) (maybe unset (\(_ /\ chosen) -> chosen) found) <<< rest)
    where
    readLast = readAlternatives (Proxy :: Proxy alternativeList)
    unset = (firstAlternative (Proxy :: Proxy alternativeList)).value
    readRest = readFields (Proxy :: Proxy tail)
  memberShapes _ = Array.cons (Choice (reflectSymbol (Proxy :: Proxy label)) (alternativeShapes (Proxy :: Proxy alternativeList))) (memberShapes (Proxy :: Proxy tail))

else instance
  ( Fail
      ( Above (Text "Every field of a message needs a number, as in `name :: 1 := String`, or is a OneOf. This one doesn't:")
          (Quote field)
      )
  ) =>
  MessageFields (RowList.Cons label field tail) plain where
  readFields _ = mkFn3 \_ _ _ -> unsafeCrashWith "unreachable"
  memberShapes _ = []

-- | How to write each field of a message, out of the whole record.
class FieldWriters :: RowList Type -> Row Type -> Constraint
class FieldWriters list whole where
  fieldWriters :: Proxy list -> Array (NumberedWriter (Record whole))

instance FieldWriters RowList.Nil whole where
  fieldWriters _ = []

else instance
  ( IsSymbol label
  , Reflectable number Int
  , Field field plainField
  , Row.Cons label plainField others whole
  , FieldWriters tail whole
  ) =>
  FieldWriters (RowList.Cons label (number := field) tail) whole where
  fieldWriters _ = Array.cons { number, write } (fieldWriters (Proxy :: Proxy tail))
    where
    number = reflectType (Proxy :: Proxy number)
    this = fieldCodec (Proxy :: Proxy field) number
    write writer message = this.write writer (Record.get (Proxy :: Proxy label) message)

else instance
  ( IsSymbol label
  , RowToList alternatives alternativeList
  , Alternatives alternativeList plainAlternatives
  , Row.Cons label (Variant plainAlternatives) others whole
  , FieldWriters tail whole
  ) =>
  FieldWriters (RowList.Cons label (OneOf alternatives) tail) whole where
  fieldWriters _ = Array.cons { number, write } (fieldWriters (Proxy :: Proxy tail))
    where
    number = (firstAlternative (Proxy :: Proxy alternativeList)).number
    writeChosen = alternativeWriter (Proxy :: Proxy alternativeList)
    write writer message = writeChosen writer (Record.get (Proxy :: Proxy label) message)

else instance FieldWriters (RowList.Cons label field tail) whole where
  fieldWriters _ = []
-- | The alternatives of a `oneof`, which need at least one.
class Alternatives :: RowList Type -> Row Type -> Constraint
class Alternatives list plain | list -> plain where
  -- | Where the last alternative came, and its value.
  readAlternatives :: Proxy list -> Fn3 Bytes Int Int (Either DecodeError (Maybe (Int /\ Variant plain)))
  alternativeWriter :: Proxy list -> Writer -> Variant plain -> Effect Unit
  -- | What a message without any of them decodes to: the lowest-numbered alternative at its default.
  firstAlternative :: Proxy list -> { number :: Int, value :: Variant plain }
  alternativeShapes :: Proxy list -> Array FieldShape

instance
  ( IsSymbol label
  , Reflectable number Int
  , Value field plainField
  , Row.Cons label plainField () plain
  ) =>
  Alternatives (RowList.Cons label (number := field) RowList.Nil) plain where
  readAlternatives _ = mkFn3 \input start end -> runFn3 readLast input start end <#> map \(at /\ found) -> at /\ Variant.inj (Proxy :: Proxy label) found
    where
    readLast = lastOccurrence (valueCodec (Proxy :: Proxy field)) (reflectType (Proxy :: Proxy number))
  alternativeWriter _ = \writer -> Variant.on (Proxy :: Proxy label) (writeAlternative this number writer) Variant.case_
    where
    number = reflectType (Proxy :: Proxy number)
    this = valueCodec (Proxy :: Proxy field)
  firstAlternative _ = { number: reflectType (Proxy :: Proxy number), value: Variant.inj (Proxy :: Proxy label) (valueCodec (Proxy :: Proxy field)).default }
  alternativeShapes _ = [ { name: reflectSymbol (Proxy :: Proxy label), number: reflectType (Proxy :: Proxy number), cardinality: Once, kind: (valueCodec (Proxy :: Proxy field)).kind } ]

else instance
  ( IsSymbol label
  , Reflectable number Int
  , Value field plainField
  , Alternatives tail plainTail
  , Row.Cons label plainField plainTail plain
  , Row.Cons label plainField () single
  , Row.Union plainTail single plain
  ) =>
  Alternatives (RowList.Cons label (number := field) tail) plain where
  readAlternatives _ = mkFn3 \input start end -> do
    here <- runFn3 readLast input start end
    rest <- runFn3 readRest input start end
    pure (later (here <#> map (Variant.inj (Proxy :: Proxy label))) (rest <#> map Variant.expand))
    where
    readLast = lastOccurrence (valueCodec (Proxy :: Proxy field)) (reflectType (Proxy :: Proxy number))
    readRest = readAlternatives (Proxy :: Proxy tail)
    later (Just (at /\ chosen)) (Just (otherAt /\ other)) = Just (if at > otherAt then at /\ chosen else otherAt /\ other)
    later (Just found) Nothing = Just found
    later Nothing other = other
  alternativeWriter _ = \writer -> Variant.on (Proxy :: Proxy label) (writeAlternative this number writer) (writeRest writer)
    where
    number = reflectType (Proxy :: Proxy number)
    this = valueCodec (Proxy :: Proxy field)
    writeRest = alternativeWriter (Proxy :: Proxy tail)
  firstAlternative _ = if number < rest.number then { number, value: Variant.inj (Proxy :: Proxy label) (valueCodec (Proxy :: Proxy field)).default } else { number: rest.number, value: Variant.expand rest.value }
    where
    number = reflectType (Proxy :: Proxy number)
    rest = firstAlternative (Proxy :: Proxy tail)
  alternativeShapes _ = Array.cons { name: reflectSymbol (Proxy :: Proxy label), number: reflectType (Proxy :: Proxy number), cardinality: Once, kind: (valueCodec (Proxy :: Proxy field)).kind } (alternativeShapes (Proxy :: Proxy tail))

-- | A oneof's alternative goes out even at its default, which is how the other side knows which
-- | one it is.
writeAlternative :: forall a. ValueCodec a -> Int -> Writer -> a -> Effect Unit
writeAlternative value number writer chosen = do
  value.write writer chosen
  Writer.tag writer (tagOf number value.wireType)

-- | How a field reads and writes its value, given its number, and what the `.proto` says it is.
type FieldCodec a =
  { read :: Reader a
  , write :: Writer -> a -> Effect Unit
  , cardinality :: Cardinality
  , kind :: ValueKind
  }

-- | `Array a` is a repeated field, `Maybe a` an optional one, anything else a field once.
class Field :: Type -> Type -> Constraint
class Field field plain | field -> plain where
  fieldCodec :: Proxy field -> Int -> FieldCodec plain

instance Value value plain => Field (Array value) (Array plain) where
  fieldCodec _ number = { read: repeated value number, write: writeRepeated value number, cardinality: Repeated, kind: value.kind }
    where
    value = valueCodec (Proxy :: Proxy value)
else instance Value value plain => Field (Maybe value) (Maybe plain) where
  fieldCodec _ number = { read: optional value number, write: writeOptional value number, cardinality: Optional, kind: value.kind }
    where
    value = valueCodec (Proxy :: Proxy value)
else instance Value value plain => Field value plain where
  fieldCodec _ number = { read: once value number, write: writeOnce value number, cardinality: Once, kind: value.kind }
    where
    value = valueCodec (Proxy :: Proxy value)

-- | How one value goes over the wire. `read` reads it where its tag ends, and says where it ends.
type ValueCodec a =
  { wireType :: Int
  , read :: Fn3 Bytes Int Int (Either DecodeError (a /\ Int))
  , write :: Writer -> a -> Effect Unit
  , isDefault :: a -> Boolean
  , default :: a
  , kind :: ValueKind
  }

-- | The types a field can have.
class Value :: Type -> Type -> Constraint
class Value value plain | value -> plain where
  valueCodec :: Proxy value -> ValueCodec plain

instance (IsSymbol name, Value value plain) => Value (Named name value) plain where
  valueCodec _ = inner { kind = named inner.kind }
    where
    inner = valueCodec (Proxy :: Proxy value)
    name = reflectSymbol (Proxy :: Proxy name)
    named = case _ of
      Nested _ shape -> Nested (Just name) shape
      Enumeration _ constructors -> Enumeration (Just name) constructors
      scalar -> scalar
else instance ProtobufMessage (Record fields) plain => Value (Record fields) plain where
  valueCodec message = nestedMessage (messageCodec message) (messageShape message)
else instance ProtobufMessage (OneOf alternatives) plain => Value (OneOf alternatives) plain where
  valueCodec message = nestedMessage (messageCodec message) (messageShape message)
else instance Value String String where
  valueCodec _ =
    { wireType: delimited
    , read: mkFn3 \input position end -> do
        let payload = Wire.varintEnd input position end
        let next = Wire.delimitedEnd input position payload end
        if next < 0 then Left (failure next position)
        else do
          let text = Wire.string input payload next
          if text == Wire.invalidUtf8 then Left (InvalidUtf8 payload) else Right (text /\ next)
    , write: Writer.string
    , isDefault: eq ""
    , default: ""
    , kind: Scalar "string"
    }
else instance Value Int Int where
  valueCodec _ = varint Wire.varint32 Writer.int32 (eq 0) 0 (Scalar "int32")
else instance Value Boolean Boolean where
  valueCodec _ = varint Wire.bool Writer.bool (eq false) false (Scalar "bool")
else instance Value Number Number where
  valueCodec _ =
    { wireType: fixed64
    , read: mkFn3 \input position end -> do
        let next = Wire.fixedEnd position 8 end
        if next < 0 then Left (failure next position) else Right (Wire.double input position /\ next)
    , write: Writer.double
    , isDefault: eq 0.0
    , default: 0.0
    , kind: Scalar "double"
    }
else instance Value Int64 Int64 where
  valueCodec _ = varint Wire.varint64 Writer.int64 (eq zero) zero (Scalar "int64")
else instance Value UInt32 UInt32 where
  valueCodec _ = varint Wire.uint32 (\writer bits -> Writer.uint32 writer (un UInt32 bits)) (eq (UInt32 0)) (UInt32 0) (Scalar "uint32")
else instance Value UInt64 UInt64 where
  valueCodec _ = varint Wire.uint64 (\writer bits -> Writer.int64 writer (un UInt64 bits)) (eq (UInt64 zero)) (UInt64 zero) (Scalar "uint64")
else instance Value Bytes Bytes where
  valueCodec _ =
    { wireType: delimited
    , read: mkFn3 \input position end -> do
        let payload = Wire.varintEnd input position end
        let next = Wire.delimitedEnd input position payload end
        if next < 0 then Left (failure next position) else Right (Wire.bytes input payload next /\ next)
    , write: Writer.bytes
    , isDefault: \bytes -> Bytes.length bytes == 0
    , default: Bytes.empty
    , kind: Scalar "bytes"
    }
else instance (Generic enum constructors, EnumConstructors constructors) => Value enum enum where
  valueCodec _ = varint read write (\value -> index value == 0) first (Enumeration Nothing names)
    where
    names = enumNames (Proxy :: Proxy constructors)
    first = to (fromMaybe (unsafeCrashWith "an enum has a constructor") (enumFromIndex (Proxy :: Proxy constructors) 0))
    read input position = fromMaybe first (enumFromIndex (Proxy :: Proxy constructors) (Wire.varint32 input position) <#> to)
    write writer value = Writer.int32 writer (index value)
    index value = enumToIndex (from value)

-- | The constructors of an enum, numbered from 0 in the order they're written.
class EnumConstructors :: Type -> Constraint
class EnumConstructors rep where
  enumNames :: Proxy rep -> Array String
  enumFromIndex :: Proxy rep -> Int -> Maybe rep
  enumToIndex :: rep -> Int

instance IsSymbol name => EnumConstructors (Constructor name NoArguments) where
  enumNames _ = [ reflectSymbol (Proxy :: Proxy name) ]
  enumFromIndex _ index = if index == 0 then Just (Constructor NoArguments) else Nothing
  enumToIndex _ = 0

instance (EnumConstructors left, EnumConstructors right) => EnumConstructors (Sum left right) where
  enumNames _ = enumNames (Proxy :: Proxy left) <> enumNames (Proxy :: Proxy right)
  enumFromIndex _ index = case enumFromIndex (Proxy :: Proxy left) index of
    Just found -> Just (Inl found)
    Nothing -> enumFromIndex (Proxy :: Proxy right) (index - Array.length (enumNames (Proxy :: Proxy left))) <#> Inr
  enumToIndex = case _ of
    Inl left -> enumToIndex left
    Inr right -> Array.length (enumNames (Proxy :: Proxy left)) + enumToIndex right

-- Reading fields.

-- | A field that comes once: the last time it comes counts, and its default if it doesn't.
once :: forall a. ValueCodec a -> Int -> Reader a
once value number = foldField number value.default \kept input tag position end ->
  if wireTypeOf tag == value.wireType then runFn3 value.read input position end
  else skipped kept input tag position end

optional :: forall a. ValueCodec a -> Int -> Reader (Maybe a)
optional value number = foldField number Nothing \kept input tag position end ->
  if wireTypeOf tag == value.wireType then runFn3 value.read input position end <#> \(found /\ next) -> Just found /\ next
  else skipped kept input tag position end

-- | Where the field came last, and its value then: for the alternatives of a oneof.
lastOccurrence :: forall a. ValueCodec a -> Int -> Reader (Maybe (Int /\ a))
lastOccurrence value number = foldField number Nothing \kept input tag position end ->
  if wireTypeOf tag == value.wireType then runFn3 value.read input position end <#> \(found /\ next) -> Just (position /\ found) /\ next
  else skipped kept input tag position end

-- | Each value as it comes, packed or one per tag, whichever the other side wrote.
repeated :: forall a. ValueCodec a -> Int -> Reader (Array a)
repeated value number = mkFn3 \input start end -> runFn3 collected input start end <#> Repeated.freeze
  where
  collected = foldField number Repeated.empty \values input tag position end ->
    if wireTypeOf tag == value.wireType then runFn3 value.read input position end <#> \(found /\ next) -> Repeated.snoc values found /\ next
    else if wireTypeOf tag == delimited && packable value then packed values input position end
    else skipped values input tag position end
  packed values input position end = do
    let payload = Wire.varintEnd input position end
    let next = Wire.delimitedEnd input position payload end
    if next < 0 then Left (failure next position) else eachPacked input next payload values <#> \all -> all /\ next
  eachPacked input end position values
    | position >= end = Right values
    | otherwise = case runFn3 value.read input position end of
        Left problem -> Left problem
        Right (found /\ next) -> eachPacked input end next (Repeated.snoc values found)

-- | Folds `step` over each time field `number` comes between two positions, and skips the
-- | other fields. `step` gets the tag and where it ends, and says where the field ends.
foldField :: forall kept. Int -> kept -> (kept -> Bytes -> Int -> Int -> Int -> Either DecodeError (kept /\ Int)) -> Reader kept
foldField number initial step = mkFn3 \input start end -> do
  let
    loop position kept
      | position >= end = Right kept
      | otherwise = do
          let afterTag = Wire.varintEnd input position end
          if afterTag < 0 then Left (failure afterTag position)
          else do
            let tag = Wire.varint32 input position
            if tag `zshr` 3 == number then case step kept input tag afterTag end of
              Left problem -> Left problem
              Right (stepped /\ next) -> loop next stepped
            else do
              let next = Wire.skip input tag afterTag end
              if next < 0 then Left (failure next afterTag) else loop next kept
  loop start initial

-- | Checks that the fields are whole, for a message without any it knows.
validated :: Reader Unit
validated = foldField (-1) unit \kept input tag position end -> skipped kept input tag position end

skipped :: forall kept. kept -> Bytes -> Int -> Int -> Int -> Either DecodeError (kept /\ Int)
skipped kept input tag position end = do
  let next = Wire.skip input tag position end
  if next < 0 then Left (failure next position) else Right (kept /\ next)

-- Writing fields. A writer writes back to front: the value first, then its tag.

writeOnce :: forall a. ValueCodec a -> Int -> Writer -> a -> Effect Unit
writeOnce value number writer field = unless (value.isDefault field) do
  value.write writer field
  Writer.tag writer (tagOf number value.wireType)

writeOptional :: forall a. ValueCodec a -> Int -> Writer -> Maybe a -> Effect Unit
writeOptional value number writer = maybe (pure unit) \field -> do
  value.write writer field
  Writer.tag writer (tagOf number value.wireType)

writeRepeated :: forall a. ValueCodec a -> Int -> Writer -> Array a -> Effect Unit
writeRepeated value number writer values
  | Array.null values = pure unit
  | packable value = do
      start <- Writer.written writer
      Writer.eachDescending values (value.write writer)
      Writer.lengthSince writer start
      Writer.tag writer (tagOf number delimited)
  | otherwise = Writer.eachDescending values \field -> do
      value.write writer field
      Writer.tag writer (tagOf number value.wireType)

-- Values.

-- | A message inside another, after its length. It always goes out, even when it's all defaults.
nestedMessage :: forall a. Codec a -> MessageShape -> ValueCodec a
nestedMessage messageCodec shape =
  { wireType: delimited
  , read: mkFn3 \input position end -> do
      let payload = Wire.varintEnd input position end
      let next = Wire.delimitedEnd input position payload end
      if next < 0 then Left (failure next position)
      else runFn3 (un Codec messageCodec).read input payload next <#> \message -> message /\ next
  , write: \writer message -> do
      start <- Writer.written writer
      (un Codec messageCodec).write writer message
      Writer.lengthSince writer start
  , isDefault: const false
  , default: allDefaults
  , kind: Nested Nothing shape
  }
  where
  allDefaults = case Codec.decode messageCodec Bytes.empty of
    Right message -> message
    Left _ -> unsafeCrashWith "no bytes are a message with every field at its default"

varint :: forall a. (Bytes -> Int -> a) -> (Writer -> a -> Effect Unit) -> (a -> Boolean) -> a -> ValueKind -> ValueCodec a
varint read write isDefault default kind =
  { wireType: 0
  , read: mkFn3 \input position end -> do
      let next = Wire.varintEnd input position end
      if next < 0 then Left (failure next position) else Right (read input position /\ next)
  , write
  , isDefault
  , default
  , kind
  }

packable :: forall a. ValueCodec a -> Boolean
packable value = value.wireType /= delimited

tagOf :: Int -> Int -> Int
tagOf number wireType = (number `shl` 3) .|. wireType

wireTypeOf :: Int -> Int
wireTypeOf tag = tag .&. 7

delimited :: Int
delimited = 2

fixed64 :: Int
fixed64 = 1
