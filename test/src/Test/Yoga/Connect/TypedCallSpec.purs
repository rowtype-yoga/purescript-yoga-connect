type Shop = Service "test.v1.Shop"
  { price :: Unary Item Price (notFound :: String)
  , catalog :: Unary {} (Array Item) ()
  , countdown :: ServerStream Int Int ()
  , total :: ClientStream Price Price ()
  , echo :: BidiStream String String (invalidArgument :: String)
  , order :: Unary Order Price Refusals
  }

type Item = Message { name :: 1 := String }

type Order = Message { name :: 1 := String, count :: 2 := Int }

-- | Errors that aren't gRPC codes, with values that aren't strings.
type Refusals =
  ( soldOut :: Int
  , banned :: WithCode "permissionDenied" String
  , backordered :: Message { name :: 1 := String, weeks :: 2 := Int }
  , notFound :: String
  )

-- | The same service as a client that knows nothing of `order`'s errors sees it.
type ShopWithoutRefusals = Service "test.v1.Shop" { order :: Unary Order Price () }

type Price = Message { cents :: 1 := Int }

type Prices = Map String Int

spec :: Spec Unit
spec = describe "a server and a client of a service type" do
  it "answers each kind of method, with the context each handler asks for" do
    connection <- startShop
    answers <- calling do
      let shop = client @Shop connection
      tea <- shop.price { name: "tea" }
      catalog <- shop.catalog {}
      countdown <- shop.countdown 3 # Strom.runCollect
      total <- shop.total (Strom.fromArray [ { cents: 150 }, { cents: 250 } ])
      echoes <- shop.echo (Strom.fromArray [ "one", "two" ]) # Strom.runCollect
      pure { tea, catalog, countdown, total, echoes }
    answers `shouldEqual` Right
      { tea: { cents: 150 }
      , catalog: [ { name: "coffee" }, { name: "tea" } ]
      , countdown: [ 3, 2, 1 ]
      , total: { cents: 400 }
      , echoes: [ "one", "two" ]
      }

  it "fails a call the handler rejects with the method's own error" do
    connection <- startShop
    rejected <- calling (try ((client @Shop connection).price { name: "gold" }) <#> lmap describeFailure)
    rejected `shouldEqual` Right (Left "notFound: we don't sell gold")

  it "fails a stream the handler rejects partway through with the method's own error" do
    connection <- startShop
    echoed <- calling do
      (client @Shop connection).echo (Strom.fromArray [ "one", "", "three" ])
        # Strom.runFold [] Array.snoc
    echoed `shouldEqual` Left "invalidArgument: say something"

  it "answers a bidi call before the client has sent anything" do
    welcomed <- welcomedBeforeSaying
    welcomed `shouldEqual` Right (Just "welcome")

  it "stops the handler's stream once the client walks away from a bidi call" do
    chattyEnds >>= shouldEqual [ "interrupted" ]

  it "fails with errors of the method's own, carrying their values" do
    connection <- startShop
    refused <- calling (refusalsOf connection)
    refused `shouldEqual` Right
      [ Left "soldOut 5", Left "banned: no tea for you", Left "backordered coffee for 3 weeks", Left "notFound: we don't sell gold" ]

  it "sends those errors as a code, a message and a detail other clients can read" do
    connection <- startShop
    seen <- calling (seenWithoutRefusals connection)
    seen `shouldEqual` Right (Just { code: FailedPrecondition, message: "soldOut", types: [ "test.v1.SoldOut" ] })

  it "answers a client generated by protoc, which only knows the old .proto" do
    connection <- startTicker
    answers <- calling do
      let generated = Generic.client Generated.ticker connection
      quotes <- generated.watch { symbols: [ "ACME" ] } # Strom.runCollect
      fills <- generated.trade (Strom.fromArray [ { symbol: "ACME", quantity: 3, limit: 120.5 } ]) # Strom.runCollect
      pure { quotes, fills }
    answers `shouldEqual` Right
      { quotes: [ { symbol: "ACME", price: 121.02, average: 121.4 } ]
      , fills: [ { symbol: "ACME", quantity: 3, price: 120.5, position: 3 } ]
      }

  it "calls a server made from protoc's generated code" do
    connection <- startGeneratedTicker
    answers <- calling do
      let typed = client @Ticker connection
      quotes <- typed.watch { symbols: [ "ACME" ] } # Strom.runCollect
      refused <- try (typed.trade (Strom.fromArray [ { symbol: "ACME", quantity: -1, limit: 1.0 } ]) # Strom.runCollect)
      pure { quotes, refused: lmap describeFailure refused }
    answers `shouldEqual` Right
      { quotes: [ { symbol: "ACME", price: 121.02, average: 121.4 } ]
      , refused: Left "failedPrecondition: you hold nothing"
      }

type Failures = (notFound :: String, invalidArgument :: String, failedPrecondition :: String, soldOut :: Int, banned :: String, backordered :: { name :: String, weeks :: Int }, connectError :: ConnectError)

calling :: forall a. OmIO Unit Failures a -> Aff (Either String a)
calling calls = runOmIO unit calls # toAff <#> lmap describeFailure

describeFailure :: Variant (exception :: Error | Failures) -> String
describeFailure = Variant.match
  { notFound: append "notFound: "
  , soldOut: \count -> "soldOut " <> show count
  , banned: append "banned: "
  , backordered: \{ name } -> "backordered " <> name
  , invalidArgument: append "invalidArgument: "
  , failedPrecondition: append "failedPrecondition: "
  , connectError: \(ConnectError { code, message: why }) -> show code <> ": " <> why
  , exception: message
  }

seenWithoutRefusals :: Connection -> OmIO Unit Failures (Maybe { code :: Code, message :: String, types :: Array String })
seenWithoutRefusals connection = do
  refused <- try ((client @ShopWithoutRefusals connection).order { name: "cake", count: 9 })
  pure case refused of
    Left failure -> failure # Variant.on (Proxy :: Proxy "connectError") (\(ConnectError { code, message: why, details }) -> Just { code, message: why, types: details <#> _.typeName }) (const Nothing)
    Right _ -> Nothing

refusalsOf :: Connection -> OmIO Unit Failures (Array (Either String { cents :: Int }))
refusalsOf connection = for orders \request -> try (shop.order request) <#> lmap describeRefusal
  where
  shop = client @Shop connection
  orders = [ { name: "cake", count: 5 }, { name: "tea", count: 1 }, { name: "coffee", count: 100 }, { name: "gold", count: 1 } ]
  describeRefusal = Variant.match
    { soldOut: \count -> "soldOut " <> show count
    , banned: append "banned: "
    , backordered: \{ name, weeks } -> "backordered " <> name <> " for " <> show weeks <> " weeks"
    , notFound: append "notFound: "
    , invalidArgument: append "invalidArgument: "
    , failedPrecondition: append "failedPrecondition: "
    , connectError: show
    , exception: message
    }

order :: Handler (Unary Order Price Refusals) ()
order = handle do
  { request: { name, count } } <- ask
  case name of
    "cake" -> reject @"soldOut" count
    "tea" -> reject @"banned" "no tea for you"
    "coffee" -> reject @"backordered" { name, weeks: 3 }
    _ -> reject @"notFound" ("we don't sell " <> name)

startShop :: Aff Connection
startShop = toAff do
  server <- createServer # liftEffect
  registerServiceWith @Shop { prices: Map.fromFoldable [ "tea" /\ 150, "coffee" /\ 200 ] } { price, catalog, countdown, total, echo, order } server # liftEffect
  bound <- listen { host: Host "127.0.0.1", port: Port 0 } server
  connect ("http://127.0.0.1:" <> show (portNumber bound.port)) # liftEffect

price :: Handler (Unary Item Price (notFound :: String)) (prices :: Prices)
price = handle do
  { request: { name }, prices } <- ask
  Map.lookup name prices # maybe (reject @"notFound" ("we don't sell " <> name)) \cents -> pure { cents }

catalog :: Handler (Unary {} (Array Item) ()) (prices :: Prices)
catalog = handle do
  { prices } <- ask
  pure (Map.keys prices # Array.fromFoldable <#> { name: _ })

countdown :: Handler (ServerStream Int Int ()) ()
countdown = handle do
  { request: from } <- ask
  pure (Strom.range 0 from <#> \step -> from - step)

total :: Handler (ClientStream Price Price ()) ()
total = handle do
  { requests } <- ask
  cents <- requests # Strom.runFold 0 (\sum { cents } -> sum + cents) # withoutRequests
  pure { cents }

echo :: Handler (BidiStream String String (invalidArgument :: String)) ()
echo = handle do
  { requests } <- ask
  pure (requests # Strom.mapM \line -> if line == "" then reject @"invalidArgument" "say something" else pure line)

-- The ticker's service as a type, and the generated one from its old `.proto`.

type Ticker = Service "ticker.v1.Ticker"
  { watch :: ServerStream (Message { symbols :: 1 := Array String }) Quote (notFound :: String)
  , trade :: BidiStream Trade Fill (failedPrecondition :: String)
  }

type Quote = Message { symbol :: 1 := String, price :: 2 := Number, average :: 3 := Number }

type Trade = Message { symbol :: 1 := String, quantity :: 2 := Int, limit :: 3 := Number }

type Fill = Message { symbol :: 1 := String, quantity :: 2 := Int, price :: 3 := Number, position :: 4 := Int }

startTicker :: Aff Connection
startTicker = toAff do
  server <- createServer # liftEffect
  registerServiceWith @Ticker {} { watch, trade } server # liftEffect
  bound <- listen { host: Host "127.0.0.1", port: Port 0 } server
  connect ("http://127.0.0.1:" <> show (portNumber bound.port)) # liftEffect
  where
  watch :: Handler (ServerStream (Message { symbols :: 1 := Array String }) Quote (notFound :: String)) ()
  watch = handle do
    { request: { symbols } } <- ask
    pure (Strom.fromArray symbols <#> \symbol -> { symbol, price: 121.02, average: 121.4 })
  trade :: Handler (BidiStream Trade Fill (failedPrecondition :: String)) ()
  trade = handle do
    { requests } <- ask
    pure (requests <#> \{ symbol, quantity, limit } -> { symbol, quantity, price: limit, position: quantity })

startGeneratedTicker :: Aff Connection
startGeneratedTicker = toAff do
  server <- createServer # liftEffect
  Server.serve Generated.ticker { watch, trade } server # liftEffect
  bound <- listen { host: Host "127.0.0.1", port: Port 0 } server
  connect ("http://127.0.0.1:" <> show (portNumber bound.port)) # liftEffect
  where
  watch :: Generated.Subscribe -> Strom.Strom Unit () Generated.Quote
  watch { symbols } = Strom.fromArray symbols <#> \symbol -> { symbol, price: 121.02, average: 121.4 }
  trade :: Strom.Strom Unit (failedPrecondition :: String) Generated.Trade -> Strom.Strom Unit (failedPrecondition :: String) Generated.Fill
  trade trades = trades # Strom.mapM \_ -> reject @"failedPrecondition" "you hold nothing"

portNumber :: Port -> Int
portNumber (Port number) = number

-- A bidi call the client walks away from, while it still has requests it could send.

type Chatty = Service "test.v1.Chatty"
  { chat :: BidiStream String String ()
  }

chattyEnds :: Aff (Array String)
chattyEnds = toAff do
  log <- newIORef []
  server <- createServer # liftEffect
  registerServiceWith @Chatty { log } { chat } server # liftEffect
  bound <- listen { host: Host "127.0.0.1", port: Port 0 } server
  connection <- connect ("http://127.0.0.1:" <> show (portNumber bound.port)) # liftEffect
  lines <- newChan
  context /\ stop <- withCancel background
  _ <- forkIO (walkAway connection lines context)
  threadDelay (Milliseconds 100.0)
  cancel stop
  threadDelay (Milliseconds 200.0)
  readIORef log
  where
  walkAway connection lines context = void (runOmIO unit (talk connection lines context))
  talk :: Connection -> Chan String -> Context -> OmIO Unit (connectError :: ConnectError) Unit
  talk connection lines context = (client @Chatty connection).chat (Strom.succeed "hello" <> Strom.fromChan lines) # Strom.forEachWithin context \_ -> pure unit
  chat :: Handler (BidiStream String String ()) (log :: IORef (Array String))
  chat = handle do
    { requests, log } <- ask
    pure (requests # Strom.onExit \exit -> atomicModifyIORef' log (\entries -> Array.snoc entries (describeExit exit) /\ unit) # liftIO)
  describeExit = case _ of
    Ended -> "ended"
    Failed _ -> "failed"
    Interrupted -> "interrupted"

-- A bidi call whose client has nothing to say yet, and whose server speaks first.

type Doorman = Service "test.v1.Doorman"
  { enter :: BidiStream String String ()
  }

welcomedBeforeSaying :: Aff (Either String (Maybe String))
welcomedBeforeSaying = do
  connection <- startDoorman
  nothingToSay <- newChan # toAff
  calling ((client @Doorman connection).enter (Strom.fromChan nothingToSay) # Strom.runHead)
  where
  startDoorman = toAff do
    server <- createServer # liftEffect
    registerServiceWith @Doorman {} { enter } server # liftEffect
    bound <- listen { host: Host "127.0.0.1", port: Port 0 } server
    connect ("http://127.0.0.1:" <> show (portNumber bound.port)) # liftEffect
  enter :: Handler (BidiStream String String ()) ()
  enter = handle do
    { requests } <- ask
    pure (Strom.succeed "welcome" <> (requests # Strom.filterMap (const Nothing)))
